# Puerto donde corre el servidor
PORT=3000

# Clave secreta para firmar los tokens JWT (cambiala por algo largo y random)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Usuario y clave del admin. OJO: se crean solos la PRIMERA vez que arranca el
# server. Si los cambiás después de ese primer arranque, corré:
#   npm run admin:set
# para que se apliquen sobre la base ya existente.
ADMIN_USER=cambiar_este_usuario
ADMIN_PASS=CambiarPass123

# Ruta secreta del panel de administración. No uses algo obvio como "admin" o
# "panel". Elegí algo que solo vos sepas, sin espacios ni caracteres raros.
# El panel va a quedar en http://tu-dominio.com/ADMIN_PATH
ADMIN_PATH=gestion-8f2k1x

# Número de WhatsApp de la tienda, con código de país, SIN + ni espacios
WHATSAPP_NUMERO=5493515646612

# --- Base de datos (Turso) ---
# Si dejás estas dos vacías, el proyecto usa un archivo SQLite local (backend/database/pupi.db),
# ideal para probar en tu PC. Para que los datos NO se pierdan en el hosting gratis,
# completá esto con los datos de tu base en https://turso.tech (ver README para el paso a paso).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Fotos (Cloudinary) ---
# Necesario para que el admin pueda subir fotos de productos y que no se pierdan
# al reiniciarse el hosting gratis. Sacás estos 3 datos de tu cuenta en
# https://cloudinary.com (ver README para el paso a paso).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
